[
  {
    "plugId": "workbuddy-exec",
    "harness": "workbuddy",
    "capabilities": [
      "exec"
    ],
    "kind": "acp",
    "command": "${WB_PYTHON:-pythonw.exe}",
    "args": [
      "${WB_MESH_DIR:-.}\\wb-gateway-adapter.py"
    ],
    "aliases": [
      "<计算机名>-workbuddy"
    ],
    "enabled": true,
    "model": null,
    "env": {
      "ADAPTER_MAX_TURN_WAIT": "1800",
      "PYTHONIOENCODING": "utf-8"
    }
  },
  {
    "plugId": "workbuddy-ui",
    "harness": "workbuddy",
    "capabilities": [
      "ui"
    ],
    "kind": "line",
    "command": "${WB_NODE:-node.exe}",
    "args": [
      "${WB_MESH_DIR:-.}\\wb-ui.js"
    ],
    "aliases": [
      "wb-ui"
    ],
    "enabled": true,
    "model": null,
    "env": {
      "WB_CDP_PORT": "9222"
    }
  },
  {
    "plugId": "zcode-exec",
    "harness": "zcode",
    "capabilities": [
      "exec"
    ],
    "kind": "acp",
    "command": "${PYTHON_EXE:-python.exe}",
    "args": [
      "${DSH_DATA_DIR:-.}\\zcode-adapter.py"
    ],
    "aliases": [
      "<计算机名>-zcode"
    ],
    "enabled": true,
    "model": null,
    "env": {
      "NODE_EXE": "${NODE_EXE:-node.exe}",
      "ZCODE_CJS": "${ZCODE_CJS:-zcode.cjs}",
      "ADAPTER_LOG": "1",
      "ADAPTER_MAX_TURN_WAIT": "1800",
      "PYTHONIOENCODING": "utf-8"
    },
    "note": "2026-10-17 晚 v2(-p 引擎)全绿:app-server 注册表 provider 在 CLI 侧无密钥,下行改走 zcode -p(login 刷新的账号凭据,实测 PONG 通过)。本机用户 20:13 zcode login 完成。"
  },
  {
    "plugId": "kimicode-exec",
    "harness": "kimicode",
    "capabilities": [
      "exec"
    ],
    "kind": "acp",
    "command": "${KIMI_EXE:-kimi.exe}",
    "args": [
      "acp"
    ],
    "no_auto_port": true,
    "aliases": [
      "<计算机名>-kimicode",
      "<计算机名>-kimicode"
    ],
    "enabled": true,
    "model": null,
    "note": "2026-10-17 kimicode 侧接好:原生 kimi.exe acp(ACP over stdio, protocolVersion 1, v2.2.0),免适配器;initialize/session/new 冒烟通过;headless 凭据有效(kimi -p PONG 实测)"
  },
  {
    "plugId": "opencode-exec",
    "harness": "opencode",
    "capabilities": [
      "exec"
    ],
    "kind": "acp",
    "command": "${OPENCODE_EXE:-opencode.exe}",
    "args": [
      "acp"
    ],
    "no_auto_port": true,
    "aliases": [
      "<计算机名>-opencode",
      "<计算机名>-opencode"
    ],
    "enabled": true,
    "model": null,
    "note": "2026-10-18 opencode 侧接好:原生 opencode acp(ACP over stdio, v1.19.3, protocolVersion 1),免适配器;no_auto_port:true(保持纯 stdio 直起:args 白名单只认 [acp];harnessd 默认会追加 --port,保守不掺);headless 凭据有效(PONG 实测);会话默认模型由 ${WB_MESH_DIR:-.}\\opencode.json 钉住 opencode/deepseek-v4.1-flash-free(全局默认 xfyun/astron key 已失效:401 apikey not found)"
  }
]
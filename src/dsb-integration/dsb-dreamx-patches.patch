diff --git a/packages/client/src/client/index.ts b/packages/client/src/client/index.ts
index 4d6b059..740ae00 100644
--- a/packages/client/src/client/index.ts
+++ b/packages/client/src/client/index.ts
@@ -183,6 +183,42 @@ export function installStyles(): () => void {
 }
 
 export function apply(ctx: ClientContext): void {
+  // ★DreamX 本地补丁(2026-10-18,与 208 主实例同思路):
+  // ① crypto.randomUUID polyfill——LAN IP(http://<SERVER_IP>)不是安全上下文,
+  //   DSB 客户端直接调 crypto.randomUUID 会 TypeError → 连接建不起来。必须最早装上。
+  // ② 自动进入 Bot 模式——启动后自动点一次"Bot 模式"(原反代的注入脚本,现移入源码)
+  if (typeof globalThis.crypto !== 'undefined' && typeof globalThis.crypto.randomUUID !== 'function') {
+    Object.defineProperty(globalThis.crypto, 'randomUUID', {
+      value: function randomUUID(): string {
+        return '10000000-1000-4000-8000-100000000000'.replace(/[018]/g, (ch) =>
+          (ch ^ (globalThis.crypto.getRandomValues(new Uint8Array(1))[0] & (15 >> (Number(ch) / 4)))).toString(16),
+        );
+      },
+      configurable: true,
+    });
+  }
+  if (typeof document !== 'undefined' && !(globalThis as { __dsbNoAutoBot?: boolean }).__dsbNoAutoBot) {
+    const autoEnterBotMode = () => {
+      let rounds = 0;
+      const timer = setInterval(() => {
+        rounds += 1;
+        const els = [...document.querySelectorAll('a,button,div,span,[role="button"],[role="treeitem"]')];
+        const btn = els.find((el) => {
+          const txt = (el.textContent ?? '').trim();
+          return txt.slice(0, 3) === 'Bot' && txt.includes('模式') && txt.length < 20;
+        });
+        if (btn) {
+          (btn as HTMLElement).click();
+          clearInterval(timer);
+        } else if (rounds > 60) {
+          clearInterval(timer);
+        }
+      }, 500);
+    };
+    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => setTimeout(autoEnterBotMode, 1500));
+    else setTimeout(autoEnterBotMode, 1500);
+  }
+
   ctx.effect(() => clearConversationDrafts);
   const storage = defaultStorage();
   const hmrView =

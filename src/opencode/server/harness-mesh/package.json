{
  "name": "@agents/harness-mesh",
  "version": "0.2.0",
  "private": true,
  "description": "Harness 组网:DSH 主控插件,经 ACP/CLI 适配器编排 opencode/kimi/zcode/workbuddy 等被控 harness",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test --experimental-test-module-mocks \"test/**/*.test.mjs\" \"test/*.test.mjs\""
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  }
}
